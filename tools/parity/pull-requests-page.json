{
  "name": "pull-requests-page",
  "viewport": [
    1400,
    900
  ],
  "theme": "dark",
  "settle_ms": 1200,
  "steps": [
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Pull requests"
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "searchbox",
        "name": "Search pull requests"
      },
      "count": 1,
      "native": {
        "role": "textbox",
        "name": "Search pull requests"
      }
    }
  ],
  "prepare": [
    {
      "helper": "panel",
      "arguments": {
        "kind": "panel"
      }
    }
  ]
}
