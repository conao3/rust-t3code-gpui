{
  "name": "composer-mention-mouse",
  "viewport": [
    1400,
    900
  ],
  "theme": "dark",
  "settle_ms": 700,
  "steps": [
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "New thread"
      }
    },
    {
      "action": "focus",
      "selector": {
        "role": "textbox",
        "name": "Message New thread"
      }
    },
    {
      "action": "type",
      "value": "@README"
    },
    {
      "action": "click",
      "selector": {
        "role": "option",
        "name": "README.md"
      },
      "native": {
        "role": "list item",
        "name": "README.md"
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "textbox",
        "name": "Message New thread"
      },
      "text_contains": "README.md"
    }
  ]
}
