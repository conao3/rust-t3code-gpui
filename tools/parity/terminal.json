{
  "name": "terminal-splits-and-thread-preservation",
  "viewport": [1400, 900],
  "theme": "dark",
  "settle_ms": 1200,
  "steps": [
    {"action": "click", "selector": {"role": "button", "name": "Fixture response, UI parity"}},
    {"action": "checkpoint", "selector": {"role": "StaticText"}, "native": {"role": "document frame", "name": "Assistant message"}, "text_contains": "Fixture output 199"},
    {"action": "press", "value": "ctrl+j"},
    {"action": "checkpoint", "selector": {"role": "button", "name": "Split Terminal Horizontally (Ctrl+D)"}},
    {"action": "checkpoint", "selector": {"role": "StaticText"}, "native": {"role": "document frame", "name": "Assistant message"}, "text_contains": "Fixture output 199"},
    {"action": "press", "value": "ctrl+d"},
    {"action": "checkpoint", "selector": {"role": "textbox", "name": "Terminal input"}, "native": {"role": "terminal"}, "count": 2},
    {"action": "press", "value": "ctrl+shift+d"},
    {"action": "checkpoint", "selector": {"role": "textbox", "name": "Terminal input"}, "native": {"role": "terminal"}, "count": 3},
    {"action": "press", "value": "ctrl+j"},
    {"action": "checkpoint", "selector": {"role": "button", "name": "Split Terminal Horizontally (Ctrl+D)"}, "count": 0},
    {"action": "press", "value": "ctrl+j"},
    {"action": "checkpoint", "selector": {"role": "textbox", "name": "Terminal input"}, "native": {"role": "terminal"}, "count": 3},
    {"action": "checkpoint", "selector": {"role": "StaticText"}, "native": {"role": "document frame", "name": "Assistant message"}, "text_contains": "Fixture output 199"}
  ],
  "prepare": [
    {
      "helper": "completed",
      "arguments": {}
    }
  ],
  "environment": {
    "stream_ms": 100
  }
}
