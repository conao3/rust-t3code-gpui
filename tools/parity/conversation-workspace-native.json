{
  "name": "side-chat-main-navigation-retains-independent-draft",
  "viewport": [
    1400,
    900
  ],
  "theme": "dark",
  "settle_ms": 500,
  "steps": [
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Pane Alpha, UI parity"
      }
    },
    {
      "action": "press",
      "value": "ctrl+alt+b"
    },
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Side chat S"
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "button",
        "name": "Bring back"
      },
      "count": 1
    },
    {
      "action": "click",
      "selector": {
        "role": "textbox",
        "name": "Message Side chat"
      }
    },
    {
      "action": "type",
      "value": "Side draft"
    },
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Pane Beta, UI parity"
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "textbox",
        "name": "Message Pane Beta"
      },
      "count": 1
    },
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Pane Alpha, UI parity"
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "textbox",
        "name": "Message Pane Alpha"
      },
      "count": 1
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "textbox",
        "name": "Message Side chat"
      },
      "value": "Side draft"
    }
  ],
  "targets": [
    "native"
  ],
  "prepare": [
    {
      "helper": "threads",
      "arguments": {
        "titles": [
          "Pane Alpha",
          "Pane Beta"
        ]
      }
    }
  ]
}
