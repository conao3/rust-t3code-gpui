{
  "name": "sidebar-shelves-restored-after-client-restart",
  "viewport": [1400, 900],
  "theme": "dark",
  "settle_ms": 350,
  "steps": [
    {"action": "click", "selector": {"role": "button", "name": "Fixture response, UI parity", "index": 0}},
    {"action": "checkpoint", "selector": {"name": "Message Fixture response"}, "count": 1},
    {"action": "checkpoint", "selector": {"role": "StaticText"}, "reference": {"role": "StaticText"}, "native": {"role": "document frame"}, "text_contains": "Fixture output 199"},
    {"action": "checkpoint", "selector": {"role": "button", "name": "Working 1", "expanded": true}, "count": 1},
    {"action": "checkpoint", "selector": {"role": "button", "name": "Shelf working fixture, Working, UI parity"}, "count": 1},
    {"action": "checkpoint", "selector": {"role": "button", "name": "Snoozed 1", "expanded": true}, "count": 1},
    {"action": "checkpoint", "selector": {"role": "button", "name": "Shelf snoozed fixture, UI parity"}, "count": 1},
    {"action": "checkpoint", "selector": {"role": "button", "name": "Settled 1", "expanded": true}, "count": 1},
    {"action": "checkpoint", "selector": {"role": "button", "name": "Shelf settled fixture, UI parity"}, "count": 1}
  ],
  "prepare": [
    {
      "helper": "mock",
      "arguments": {
        "stream_ms": 100
      }
    },
    {
      "helper": "completed",
      "arguments": {}
    },
    {
      "helper": "threads",
      "arguments": {
        "titles": [
          "Shelf snoozed fixture",
          "Shelf settled fixture"
        ]
      }
    },
    {
      "helper": "snooze",
      "arguments": {
        "title": "Shelf snoozed fixture"
      }
    },
    {
      "helper": "settle",
      "arguments": {
        "title": "Shelf settled fixture"
      }
    },
    {
      "helper": "mock",
      "arguments": {
        "stream_ms": 3600000
      }
    },
    {
      "helper": "running",
      "arguments": {
        "title": "Shelf working fixture"
      }
    },
    {
      "helper": "actions",
      "arguments": {
        "steps": [
          {
            "action": "click",
            "selector": {
              "role": "button",
              "name": "Working 1"
            }
          },
          {
            "action": "click",
            "selector": {
              "role": "button",
              "name": "Snoozed 1"
            }
          },
          {
            "action": "click",
            "selector": {
              "role": "button",
              "name": "Settled 1"
            }
          },
          {
            "action": "checkpoint",
            "selector": {
              "role": "button",
              "name": "Working 1",
              "expanded": true
            },
            "count": 1,
            "screenshot": false
          },
          {
            "action": "checkpoint",
            "selector": {
              "role": "button",
              "name": "Snoozed 1",
              "expanded": true
            },
            "count": 1,
            "screenshot": false
          },
          {
            "action": "checkpoint",
            "selector": {
              "role": "button",
              "name": "Settled 1",
              "expanded": true
            },
            "count": 1,
            "screenshot": false
          }
        ]
      }
    },
    {
      "helper": "reload_clients",
      "arguments": {}
    }
  ],
  "environment": {
    "stream_ms": 100
  }
}
