{
  "name": "usage-quality-summary",
  "viewport": [
    1400,
    900
  ],
  "theme": "dark",
  "settle_ms": 1500,
  "steps": [
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Usage"
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "dialog",
        "name": "Usage"
      }
    },
    {
      "action": "press",
      "value": "c"
    },
    {
      "action": "checkpoint",
      "selector": {
        "name": "Totals"
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "button",
        "name": "Unpriced usage details"
      }
    },
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Unpriced usage details"
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "name": "API estimate excludes 33.3% unpriced records."
      },
      "reference": {
        "role": "StaticText",
        "name": "33.3%",
        "ancestor": {
          "role": "dialog",
          "name": ""
        }
      }
    },
    {
      "action": "press",
      "value": "escape"
    }
  ],
  "prepare": [
    {
      "helper": "mock",
      "arguments": {
        "stream_ms": 100,
        "usage_models": [
          "gpt-6-luna",
          "gpt-6-sol",
          "parity-unpriced"
        ]
      }
    },
    {
      "helper": "completed",
      "arguments": {
        "title": "Usage fixture"
      }
    },
    {
      "helper": "settings",
      "arguments": {
        "usagePriceOverrides": {
          "gpt-6-luna": {
            "inputCostPerMillionTokens": 2,
            "outputCostPerMillionTokens": 10,
            "cacheReadCostPerMillionTokens": 0.2
          },
          "gpt-6-sol": {
            "inputCostPerMillionTokens": 2,
            "outputCostPerMillionTokens": 10,
            "cacheReadCostPerMillionTokens": 0.2
          }
        }
      }
    },
    {
      "helper": "usage",
      "arguments": {}
    }
  ]
}
