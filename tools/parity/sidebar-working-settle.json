{
  "name": "working-thread-settle-rejection-preserves-the-run-and-current-thread",
  "theme": "dark",
  "viewport": [
    1400,
    900
  ],
  "settle_ms": 200,
  "steps": [
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Working 1",
        "expanded": false
      }
    },
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Working transition fixture, Working, UI parity"
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "textbox",
        "name": "Message Working transition fixture"
      },
      "count": 1,
      "screenshot": false
    },
    {
      "action": "focus",
      "selector": {
        "role": "button",
        "name": "Settle thread",
        "ancestor": {
          "role": "button",
          "name": "Working transition fixture, Working, UI parity"
        }
      }
    },
    {
      "action": "press",
      "value": "enter"
    },
    {
      "action": "pointer",
      "kind": "move",
      "x": 1160,
      "y": 120
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "dialog",
        "name": "Failed to settle thread"
      },
      "count": 1,
      "screenshot": true
    },
    {
      "action": "checkpoint",
      "selector": {
        "name": "Thread 66666666-1111-4111-8111-000000000004 is still running. Stop it before settling.",
        "role": "label"
      },
      "reference": {
        "role": "StaticText",
        "name": "Thread 66666666-1111-4111-8111-000000000004 is still running. Stop it before settling."
      },
      "count": 1,
      "screenshot": false
    },
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Copy error"
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "button",
        "name": "Copied error"
      },
      "count": 1,
      "screenshot": false
    },
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Dismiss notification"
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "dialog",
        "name": "Failed to settle thread"
      },
      "count": 0,
      "screenshot": false
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "textbox",
        "name": "Message Working transition fixture"
      },
      "count": 1,
      "screenshot": false
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "button",
        "name": "Working 1",
        "expanded": true
      },
      "count": 1,
      "screenshot": false
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "button",
        "name": "Settled 0"
      },
      "count": 1,
      "screenshot": false
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "button",
        "name": "Working transition fixture, Working, UI parity"
      },
      "count": 1,
      "screenshot": false
    }
  ],
  "prepare": [
    {
      "helper": "running",
      "arguments": {
        "title": "Working transition fixture"
      }
    }
  ],
  "environment": {
    "stream_ms": 3600000
  }
}
