{
  "name": "math-mermaid-and-timeline-minimap",
  "viewport": [
    1400,
    900
  ],
  "theme": "dark",
  "settle_ms": 500,
  "steps": [
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Pane Alpha, UI parity"
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "button",
        "name": "Expand diagram"
      },
      "count": 2
    },
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Show code",
        "index": 1
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "button",
        "name": "Show diagram"
      },
      "count": 1
    },
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Show diagram"
      }
    },
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Copy code",
        "index": 1
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "button",
        "name": "Copy code"
      },
      "count": 2,
      "screenshot": false
    },
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Expand diagram",
        "index": 1
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "region",
        "name": "Mermaid diagram, zoomable image"
      },
      "count": 1
    },
    {
      "action": "focus",
      "selector": {
        "role": "region",
        "name": "Mermaid diagram, zoomable image"
      }
    },
    {
      "action": "press",
      "value": "enter"
    },
    {
      "action": "press",
      "value": "right"
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "region",
        "name": "Mermaid diagram, zoomable image"
      },
      "count": 1
    },
    {
      "action": "press",
      "value": "0"
    },
    {
      "action": "press",
      "value": "escape"
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "button",
        "name": "Expand diagram"
      },
      "count": 2
    }
  ],
  "prepare": [
    {
      "helper": "mock",
      "arguments": {
        "stream_ms": 100,
        "text": "Inline math $E = mc^2$ and $\\frac{a}{b}$ stay on the text baseline.\n\n$$\n\\int_0^1 x^2\\,dx = \\frac{1}{3}\n$$\n\n```mermaid\nflowchart LR\n    A[Question] --> B{Ready?}\n    B -->|Yes| C[Answer]\n    B -->|No| A\n```\n\nThe diagram preserves the author's left-to-right direction.\n"
      }
    },
    {
      "helper": "completed",
      "arguments": {
        "title": "Pane Alpha",
        "prompts": [
          "First question: show an equation and a diagram.",
          "Second question: keep the same diagram."
        ]
      }
    }
  ]
}
