{
  "name": "snooze-settings-remove-the-added-option",
  "viewport": [
    1400,
    900
  ],
  "theme": "dark",
  "settle_ms": 700,
  "steps": [
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Remove snooze option 6"
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "name": "Snooze option 6"
      },
      "count": 0
    },
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Close"
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "textbox",
        "name": "Message Snooze interaction fixture"
      },
      "count": 1
    }
  ],
  "prepare": [
    {
      "helper": "threads",
      "arguments": {
        "titles": [
          "Next interaction fixture",
          "Snooze interaction fixture"
        ]
      }
    },
    {
      "helper": "actions",
      "arguments": {
        "steps": [
          {
            "action": "click",
            "selector": {
              "role": "button",
              "name": "Snooze interaction fixture, UI parity"
            }
          },
          {
            "action": "focus",
            "selector": {
              "role": "button",
              "name": "Snooze thread",
              "index": 0
            }
          },
          {
            "action": "press",
            "value": "enter"
          },
          {
            "action": "click",
            "selector": {
              "role": "menuitem",
              "name": "Custom…"
            },
            "native": {
              "role": "menu item",
              "name": "Custom…"
            }
          },
          {
            "action": "click",
            "selector": {
              "role": "button",
              "name": "Edit snooze options"
            }
          },
          {
            "action": "click",
            "selector": {
              "role": "button",
              "name": "Add option"
            }
          }
        ]
      }
    }
  ]
}
