{
  "name": "side-chat-focus-and-empty-close",
  "viewport": [
    1400,
    900
  ],
  "theme": "dark",
  "settle_ms": 500,
  "steps": [
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Pane Alpha, UI parity"
      }
    },
    {
      "action": "press",
      "value": "ctrl+alt+b"
    },
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Side chat S"
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "button",
        "name": "Bring back"
      },
      "count": 1
    },
    {
      "action": "click",
      "selector": {
        "role": "textbox",
        "name": "Message Pane Alpha"
      }
    },
    {
      "action": "type",
      "value": "First pane draft"
    },
    {
      "action": "click",
      "selector": {
        "role": "textbox",
        "name": "Message Side chat"
      }
    },
    {
      "action": "type",
      "value": "Second pane draft"
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "textbox",
        "name": "Message Pane Alpha"
      },
      "value": "First pane draft"
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "textbox",
        "name": "Message Side chat"
      },
      "value": "Second pane draft"
    },
    {
      "action": "click",
      "selector": {
        "role": "button",
        "name": "Close side chat"
      }
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "textbox",
        "name": "Message Side chat"
      },
      "count": 0
    },
    {
      "action": "press",
      "value": "ctrl+shift+t"
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "textbox",
        "name": "Message Side chat"
      },
      "count": 0
    },
    {
      "action": "checkpoint",
      "selector": {
        "role": "textbox",
        "name": "Message Pane Alpha"
      },
      "value": "First pane draft"
    }
  ]
}
